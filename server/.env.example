# ===== Email Provider Configuration =====
# Choose 'smtp' for reliable Gmail/email delivery (RECOMMENDED)
# Choose 'resend' to use Resend API (note: onboarding@resend.dev sandbox has recipient restrictions)
EMAIL_PROVIDER=smtp

# ===== SMTP / Gmail Configuration =====
# For Gmail:
# 1. Use your Gmail address as SMTP_USER
# 2. Create an App Password at https://myaccount.google.com/apppasswords
#    (Requires 2-Step Verification enabled on your Google Account)
# 3. Paste the 16-character App Password as SMTP_PASS (no spaces)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=rohitkumarhjp9097@gmail.com
SMTP_PASS=your_gmail_app_password_here

# ===== Resend API Configuration (only needed if EMAIL_PROVIDER=resend) =====
RESEND_API_KEY=your_resend_api_key_here

# ===== Email Addresses =====
# EMAIL_FROM: For SMTP, this should match or be the same as SMTP_USER
EMAIL_FROM=rohitkumarhjp9097@gmail.com
EMAIL_TO=rohitkumarhjp9097@gmail.com

# ===== Server Configuration =====
PORT=10000
NODE_ENV=production
FRONTEND_URL=https://your-frontend-url.com
